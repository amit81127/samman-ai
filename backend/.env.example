# ── Application ──────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# ── MongoDB Atlas ─────────────────────────────────────────────────────────
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net
# Get from: https://cloud.mongodb.com → Database → Connect
MONGODB_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net
DATABASE_NAME=samaan_ai

# ── Security ──────────────────────────────────────────────────────────────
# Generate secret: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=replace_with_a_64_char_hex_random_secret_never_commit_real_value
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── CORS ──────────────────────────────────────────────────────────────────
# In production: https://your-frontend-domain.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# ── Google Gemini API & Intelligent Routing ──────────────────────────────
# Get API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key

GEMINI_PRIMARY_MODEL=gemini-3.5-flash-lite
GEMINI_ADVANCED_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

GEMINI_ENABLE_SMART_ROUTING=true
GEMINI_ENABLE_FALLBACK=true

GEMINI_LITE_DAILY_LIMIT=450
GEMINI_ADVANCED_DAILY_LIMIT=18

GEMINI_LITE_RPM_LIMIT=12
GEMINI_ADVANCED_RPM_LIMIT=4

GEMINI_MAX_RETRIES=2
GEMINI_TIMEOUT_SECONDS=30

GEMINI_QUOTA_TIMEZONE=Asia/Kolkata

# ── Gnani AI (Phase 4) ────────────────────────────────────────────────────
# IMPORTANT: Verify these URLs with Gnani before Phase 4
# Contact: https://gnani.ai — confirm endpoint, auth method, voice IDs
GNANI_API_KEY=your_gnani_api_key_here
GNANI_TTS_BASE_URL=https://api.gnani.ai/tts
GNANI_STT_BASE_URL=https://api.gnani.ai/stt
GNANI_TIMEOUT_SECONDS=15
GNANI_DEFAULT_LANGUAGE=en-IN
GNANI_DEFAULT_VOICE=female_1

# ── Background Worker & Jobs (No Redis) ──────────────────────────────────
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_SECONDS=2.0
WORKER_LOCK_TIMEOUT_SECONDS=120
WORKER_MAX_RETRIES=3

# ── Production Observability & Sentry (Optional) ─────────────────────────
SENTRY_DSN=

# ── Rate Limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_AI_GENERATION=10/minute
RATE_LIMIT_TTS=20/minute
